<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MusicPlayer.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Library">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="15">

        <Grid
            x:Name="TopBar"
            Grid.Row="0"
            ColumnDefinitions="*,Auto,Auto">

            <Label
                Text="Music Library"
                FontSize="30"
                FontAttributes="Bold"
                VerticalOptions="Center"/>

            <Button
                Grid.Column="1"
                Margin="0,0,10,0"
                Text="Sort"
                CornerRadius="10"
                Clicked="SortButton_Clicked"/>

            <Button
                x:Name="AddMusicButton"
                Grid.Column="2"
                Text="Import"
                BackgroundColor="Orange"
                TextColor="White"
                CornerRadius="10"
                Clicked="AddMusicButton_Clicked"/>

        </Grid>

        <SearchBar
            Grid.Row="1"
            x:Name="SearchBar"
            Placeholder="Search songs..."
            TextChanged="SearchBar_TextChanged"/>

        <VerticalStackLayout
            x:Name="EmptyState"
            Grid.Row="2"
            IsVisible="False"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Padding="20"
            Spacing="12">

            <Label
                FontSize="72"
                HorizontalTextAlignment="Center"
                Text="🎵"/>

            <Label
                x:Name="EmptyTitle"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"/>

            <Label
                x:Name="EmptyMessage"
                FontSize="16"
                HorizontalTextAlignment="Center"
                Opacity="0.7"/>

            <Button
                x:Name="EmptyButton"
                WidthRequest="180"
                HeightRequest="45"
                CornerRadius="10"
                BackgroundColor="Orange"
                TextColor="White"
                Clicked="EmptyButton_Clicked"/>

        </VerticalStackLayout>

        <CollectionView
            x:Name="SongsCollection"
            Grid.Row="2"
            ItemsSource="{Binding Songs}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="0,0,0,12"
                        Padding="12"
                        Stroke="#DDDDDD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="3">

                                <Label
                                    Text="{Binding Title}"
                                    FontSize="18"
                                    FontAttributes="Bold"/>

                                <Label
                                    Text="{Binding Artist}"
                                    FontSize="14"/>

                                <Label
                                    Text="{Binding Album}"
                                    FontSize="12"
                                    Opacity="0.6"/>

                            </VerticalStackLayout>

                            <HorizontalStackLayout
                                Grid.Column="1"
                                Spacing="8"
                                VerticalOptions="Center">

                                <Button
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    CornerRadius="21"
                                    Text="▶"
                                    Clicked="PlaySong_Clicked"
                                    CommandParameter="{Binding}" />

                                <Button
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    CornerRadius="21"
                                    Text="🗑"
                                    Clicked="DeleteSong_Clicked"
                                    CommandParameter="{Binding}" />

                            </HorizontalStackLayout>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>