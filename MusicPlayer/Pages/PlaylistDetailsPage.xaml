<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MusicPlayer.Pages.PlaylistDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Playlist">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="15">

        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto,Auto">

            <Label
                x:Name="PlaylistNameLabel"
                FontSize="30"
                FontAttributes="Bold"
                VerticalOptions="Center"/>

            <Button
                Grid.Column="1"
                Margin="0,0,10,0"
                Text="Add"
                BackgroundColor="Orange"
                TextColor="White"
                CornerRadius="10"
                Clicked="AddSongs_Clicked"/>

            <Button
                Grid.Column="2"
                Text="Play"
                CornerRadius="10"
                Clicked="PlayPlaylist_Clicked"/>

        </Grid>

        <Label
            Grid.Row="1"
            Text="Songs"
            FontSize="18"
            FontAttributes="Bold"/>

        <CollectionView
            Grid.Row="2"
            x:Name="SongsCollectionView"
            SelectionMode="Single"
            SelectionChanged="SongsCollectionView_SelectionChanged">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="0,0,0,12"
                        Padding="12"
                        Stroke="#DDDDDD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout
                                Spacing="3">

                                <Label
                                    Text="{Binding Title}"
                                    FontSize="18"
                                    FontAttributes="Bold"/>

                                <Label
                                    Text="{Binding Artist}"
                                    FontSize="14"/>

                                <Label
                                    Text="{Binding Album}"
                                    FontSize="12"
                                    Opacity="0.6"/>

                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                WidthRequest="42"
                                HeightRequest="42"
                                CornerRadius="21"
                                Text="🗑"
                                CommandParameter="{Binding}"
                                Clicked="DeleteSong_Clicked"/>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>