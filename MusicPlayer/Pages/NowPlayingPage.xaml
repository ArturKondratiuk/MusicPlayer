<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MusicPlayer.Pages.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Now Playing">

    <VerticalStackLayout
        Padding="20"
        Spacing="20">

        <Image
            WidthRequest="250"
            HeightRequest="250"
            BackgroundColor="LightGray"
            Aspect="AspectFill" />

        <Label
            FontSize="28"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center"
            Text="{Binding Title}" />

        <Label
            FontSize="18"
            HorizontalTextAlignment="Center"
            Text="{Binding Artist}" />

        <Label
            FontSize="16"
            HorizontalTextAlignment="Center"
            Text="{Binding Album}" />

        <Grid RowDefinitions="Auto,Auto,Auto"
      Margin="0,20,0,0">

            <!-- Полоса -->

            <Slider
        x:Name="ProgressSlider"
        Grid.Row="0"
        Minimum="0"
        DragStarted="ProgressSlider_DragStarted"
        DragCompleted="ProgressSlider_DragCompleted"/>

            <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*">

                <Label
                x:Name="CurrentTimeLabel"
                HorizontalOptions="Start"/>

                <Label
                x:Name="DurationLabel"
                HorizontalOptions="End"
                Grid.Column="1"/>

            </Grid>

            <HorizontalStackLayout
            Grid.Row="2"
            HorizontalOptions="Center"
            Margin="0,20,0,0"
            Spacing="20">

                <Button
                Text="⏮"
                Clicked="Previous_Clicked"/>

                <Button
                Text="⏯"
                Clicked="PlayPause_Clicked"/>

                <Button
                Text="⏹"
                Clicked="Stop_Clicked"/>

                <Button
                Text="⏭"
                Clicked="Next_Clicked"/>

            </HorizontalStackLayout>

        </Grid>

    </VerticalStackLayout>

</ContentPage>