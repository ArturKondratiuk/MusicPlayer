<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MusicPlayer.Pages.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Now Playing">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="20">

            <Image
                x:Name="AlbumImage"
                WidthRequest="280"
                HeightRequest="280"
                HorizontalOptions="Center"
                Aspect="AspectFill"
                Source="{Binding AlbumArt}" />

            <Label
                Text="{Binding Title}"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"/>

            <Label
                Text="{Binding Artist}"
                FontSize="18"
                HorizontalTextAlignment="Center"/>

            <Label
                Text="{Binding Album}"
                FontSize="15"
                Opacity="0.7"
                HorizontalTextAlignment="Center"/>

            <Slider
                x:Name="ProgressSlider"
                Minimum="0"
                DragStarted="ProgressSlider_DragStarted"
                DragCompleted="ProgressSlider_DragCompleted"/>

            <Grid ColumnDefinitions="*,*">

                <Label
                    x:Name="CurrentTimeLabel"
                    HorizontalOptions="Start"/>

                <Label
                    x:Name="DurationLabel"
                    Grid.Column="1"
                    HorizontalOptions="End"/>

            </Grid>

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="25">

                <Button
                    FontSize="24"
                    WidthRequest="65"
                    HeightRequest="65"
                    Text="⏮"
                    Clicked="Previous_Clicked"/>

                <Button
                    FontSize="24"
                    WidthRequest="65"
                    HeightRequest="65"
                    Text="⏯"
                    Clicked="PlayPause_Clicked"/>

                <Button
                    FontSize="24"
                    WidthRequest="65"
                    HeightRequest="65"
                    Text="⏭"
                    Clicked="Next_Clicked"/>

            </HorizontalStackLayout>

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Margin="0,15,0,0"
                Spacing="15">

                <Button
                    x:Name="ShuffleButton"
                    WidthRequest="90"
                    Text="🔀"
                    Clicked="Shuffle_Clicked"/>

                <Button
                    Text="⏹"
                    WidthRequest="90"
                    Clicked="Stop_Clicked"/>

                <Button
                    x:Name="RepeatButton"
                    WidthRequest="90"
                    Text="➡️"
                    Clicked="Repeat_Clicked"/>

            </HorizontalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>