<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MusicPlayer.Pages.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Now Playing">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="20">

            <Border
                HorizontalOptions="Center"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20">

                <Image
                    x:Name="AlbumImage"
                    WidthRequest="280"
                    HeightRequest="280"
                    Aspect="AspectFill"/>

            </Border>

            <Label
                Text="{Binding Title}"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                LineBreakMode="TailTruncation"/>

            <Label
                Text="{Binding Artist}"
                FontSize="20"
                HorizontalTextAlignment="Center"
                Opacity="0.9"/>

            <Label
                Text="{Binding Album}"
                FontSize="15"
                HorizontalTextAlignment="Center"
                Opacity="0.6"/>

            <Slider
                x:Name="ProgressSlider"
                Minimum="0"
                DragStarted="ProgressSlider_DragStarted"
                DragCompleted="ProgressSlider_DragCompleted"/>

            <Grid ColumnDefinitions="Auto,*">

                <Label
                    x:Name="CurrentTimeLabel"/>

                <Label
                    x:Name="DurationLabel"
                    Grid.Column="1"
                    HorizontalOptions="End"/>

            </Grid>

            <!-- Playback buttons -->

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="25">

                <Button
                    WidthRequest="65"
                    HeightRequest="65"
                    CornerRadius="32"
                    FontSize="24"
                    Text="⏮"
                    Clicked="Previous_Clicked"/>

                <Button
                    x:Name="PlayPauseButton"
                    WidthRequest="75"
                    HeightRequest="75"
                    CornerRadius="38"
                    FontSize="28"
                    Text="▶"
                    Clicked="PlayPause_Clicked"/>

                <Button
                    WidthRequest="65"
                    HeightRequest="65"
                    CornerRadius="32"
                    FontSize="24"
                    Text="⏭"
                    Clicked="Next_Clicked"/>

            </HorizontalStackLayout>

            <!-- Shuffle / Stop / Repeat -->

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="15">

                <Button
                    x:Name="ShuffleButton"
                    WidthRequest="90"
                    Text="🔀"
                    Clicked="Shuffle_Clicked"/>

                <Button
                    WidthRequest="90"
                    Text="⏹"
                    Clicked="Stop_Clicked"/>

                <Button
                    x:Name="RepeatButton"
                    WidthRequest="90"
                    Text="🔁"
                    Clicked="Repeat_Clicked"/>

            </HorizontalStackLayout>

            <Grid
                Margin="0,15,0,0"
                WidthRequest="260"
                HorizontalOptions="Center"
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10">

                <Label
                    Text="🔉"
                    FontSize="18"
                    VerticalOptions="Center"/>

                <Slider
                    x:Name="VolumeSlider"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="1"
                    ValueChanged="VolumeSlider_ValueChanged"
                    VerticalOptions="Center"/>

                <Label
                    Grid.Column="2"
                    Text="🔊"
                    FontSize="18"
                    VerticalOptions="Center"/>

            </Grid>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>