<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MusicPlayer.Pages.AddSongsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MusicPlayer.Models"
    Title="Add Songs">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="15">

        <!-- page title -->
        <Label
            Grid.Row="0"
            Text="Add Songs"
            FontSize="30"
            FontAttributes="Bold"/>

        <!-- search -->
        <SearchBar
            x:Name="SearchBar"
            Grid.Row="1"
            Placeholder="Search songs..."
            TextChanged="SearchBar_TextChanged"/>

        <!-- empty search result -->
        <VerticalStackLayout
            x:Name="EmptyState"
            Grid.Row="2"
            IsVisible="False"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="12">

            <Label
                x:Name="EmptyIcon"
                FontSize="70"
                HorizontalTextAlignment="Center"/>

            <Label
                x:Name="EmptyTitle"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"/>

            <Label
                x:Name="EmptyMessage"
                FontSize="16"
                HorizontalTextAlignment="Center"
                Opacity="0.7"/>

        </VerticalStackLayout>

        <!-- empty library -->
        <VerticalStackLayout
            x:Name="LibraryEmptyState"
            Grid.Row="2"
            IsVisible="False"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="12">

            <Label
                Text="🎵"
                FontSize="72"
                HorizontalTextAlignment="Center"/>

            <Label
                Text="Library is empty"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"/>

            <Label
                Text="Import music before creating playlists."
                FontSize="16"
                Opacity="0.7"
                HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>

        <!-- song list -->
        <CollectionView
            x:Name="SongsCollection"
            Grid.Row="2"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:Song">

                    <Border
                        Margin="0,0,0,12"
                        Padding="12"
                        Stroke="#DDDDDD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout
                                Spacing="3">

                                <Label
                                    Text="{Binding Title}"
                                    FontSize="18"
                                    FontAttributes="Bold"/>

                                <Label
                                    Text="{Binding Artist}"
                                    FontSize="14"/>

                                <Label
                                    Text="{Binding Album}"
                                    FontSize="12"
                                    Opacity="0.6"/>

                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                WidthRequest="42"
                                HeightRequest="42"
                                CornerRadius="21"
                                BackgroundColor="#EEEEEE"
                                Text="+"
                                FontAttributes="Bold"
                                CommandParameter="{Binding}"
                                Clicked="SelectSong_Clicked"/>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- save button -->
        <Button
            x:Name="SaveButton"
            Grid.Row="3"
            HeightRequest="50"
            CornerRadius="10"
            BackgroundColor="Orange"
            TextColor="White"
            Text="Add Selected Songs"
            Clicked="Save_Clicked"/>

    </Grid>

</ContentPage>