<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MusicPlayer.Pages.AddSongsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Add Songs">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="15">

        <Label
            Grid.Row="0"
            Text="Add Songs"
            FontSize="30"
            FontAttributes="Bold"/>

        <SearchBar
            x:Name="SearchBar"
            Grid.Row="1"
            Placeholder="Search songs..."
            TextChanged="SearchBar_TextChanged"/>

        <CollectionView
            x:Name="LibraryView"
            Grid.Row="2"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="0,0,0,12"
                        Padding="12"
                        Stroke="#DDDDDD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout
                                Spacing="3">

                                <Label
                                    Text="{Binding Title}"
                                    FontSize="18"
                                    FontAttributes="Bold"/>

                                <Label
                                    Text="{Binding Artist}"
                                    FontSize="14"/>

                                <Label
                                    Text="{Binding Album}"
                                    FontSize="12"
                                    Opacity="0.6"/>

                            </VerticalStackLayout>

                            <Button
                                x:Name="SaveButton"
                                Grid.Column="1"
                                WidthRequest="42"
                                HeightRequest="42"
                                CornerRadius="21"
                                Text="+"
                                Clicked="SelectSong_Clicked"
                                CommandParameter="{Binding}" />

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button
            Grid.Row="3"
            HeightRequest="50"
            CornerRadius="10"
            BackgroundColor="Orange"
            TextColor="White"
            Text="Add Selected Songs"
            Clicked="Save_Clicked"/>

    </Grid>

</ContentPage>