<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MusicPlayer.Pages.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Playlists">

    <VerticalStackLayout Padding="20">

        <Label
            Text="Playlists"
            FontSize="30"
            FontAttributes="Bold"/>

        <Button
            Margin="0,15,0,0"
            Text="Create Playlist"
            Clicked="CreatePlaylist_Clicked"/>

        <CollectionView
            Margin="0,20,0,0"
            ItemsSource="{Binding Playlists}">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame Margin="0,0,0,10">

                        <VerticalStackLayout>

                            <Label
                                FontSize="20"
                                FontAttributes="Bold"
                                Text="{Binding Name}"/>

                            <Label
                                Text="{Binding Songs.Count,StringFormat='Songs: {0}'}"/>

                            <HorizontalStackLayout Margin="0,10,0,0">

                                <Button
                                    Text="Open"
                                    Clicked="OpenPlaylist_Clicked"
                                    CommandParameter="{Binding}"/>

                                <Button
                                    Margin="10,0,0,0"
                                    Text="Delete"
                                    Clicked="DeletePlaylist_Clicked"
                                    CommandParameter="{Binding}"/>

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>