<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns:viewModels="clr-namespace:MusicPlayer.ViewModels"
    x:DataType="viewModels:PlaylistViewModel"
    xmlns:models="clr-namespace:MusicPlayer.Models"
    x:Class="MusicPlayer.Pages.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Playlists">

    <Grid
        Padding="20"
        RowDefinitions="Auto,*"
        RowSpacing="15">

        <Grid
            x:Name="TopBar"
            Grid.Row="0"
            ColumnDefinitions="*,Auto">

            <Label
                Text="Playlists"
                FontSize="30"
                FontAttributes="Bold"
                VerticalOptions="Center"/>

            <Button
                Grid.Column="1"
                Text="Create"
                BackgroundColor="Orange"
                TextColor="White"
                CornerRadius="10"
                Clicked="CreatePlaylist_Clicked"/>

        </Grid>

        <VerticalStackLayout
            x:Name="EmptyState"
            Grid.Row="1"
            IsVisible="False"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="12">

            <Label
                FontSize="72"
                HorizontalTextAlignment="Center"
                Text="📂"/>

            <Label
                FontSize="24"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                Text="No playlists yet"/>

            <Label
                FontSize="16"
                HorizontalTextAlignment="Center"
                Opacity="0.7"
                Text="Create your first playlist to organize your music."/>

            <Button
                WidthRequest="180"
                HeightRequest="45"
                CornerRadius="10"
                BackgroundColor="Orange"
                TextColor="White"
                Text="Create Playlist"
                Clicked="CreatePlaylist_Clicked"/>

        </VerticalStackLayout>

        <CollectionView
            x:Name="PlaylistsCollection"
            Grid.Row="1"
            ItemsSource="{Binding Playlists}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:Playlist">

                    <Border
                        Margin="0,0,0,12"
                        Padding="15"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#555555}"
                        StrokeShape="RoundRectangle 12">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout
                                Spacing="4">

                                <Label
                                    Text="{Binding Name}"
                                    FontSize="20"
                                    FontAttributes="Bold"/>

                                <Label
                                    Text="{Binding Songs.Count, StringFormat='Songs: {0}'}"
                                    FontSize="14"
                                    Opacity="0.7"/>

                            </VerticalStackLayout>

                            <HorizontalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Spacing="8">

                                <Button
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    CornerRadius="21"
                                    Text="📂"
                                    Clicked="OpenPlaylist_Clicked"
                                    CommandParameter="{Binding}"/>

                                <Button
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    CornerRadius="21"
                                    Text="✏️"
                                    Clicked="RenamePlaylist_Clicked"
                                    CommandParameter="{Binding}"/>

                                <Button
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    CornerRadius="21"
                                    Text="🗑"
                                    Clicked="DeletePlaylist_Clicked"
                                    CommandParameter="{Binding}"/>

                            </HorizontalStackLayout>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>