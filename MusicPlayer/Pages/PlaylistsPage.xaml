<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MusicPlayer.Pages.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Playlists">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                FontSize="30"
                FontAttributes="Bold"
                Text="Playlists" />

            <Button
                Text="Create Playlist"
                Clicked="CreatePlaylist_Clicked" />

            <CollectionView
                Margin="0,10,0,0"
                ItemsSource="{Binding Playlists}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,0,0,12"
                            Padding="15"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#555555}"
                            Background="{AppThemeBinding Light=White, Dark=#2A2A2A}">

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    Text="{Binding Name}" />

                                <Label
                                    FontSize="14"
                                    Text="{Binding Songs.Count, StringFormat='Songs: {0}'}" />

                                <HorizontalStackLayout
                                    Margin="0,10,0,0"
                                    Spacing="10">

                                    <Button
                                        Text="Open"
                                        Clicked="OpenPlaylist_Clicked"
                                        CommandParameter="{Binding}" />

                                    <Button
                                        Text="Delete"
                                        Clicked="DeletePlaylist_Clicked"
                                        CommandParameter="{Binding}" />

                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>